install_subdir(
  'locales.d',
  install_dir: get_option('datadir') / 'libgsword',
)

install_data(
  'org.gsword.GSword.desktop',
  install_dir: get_option('datadir') / 'applications',
)

install_data(
  'org.gsword.GSword.metainfo.xml',
  install_dir: get_option('datadir') / 'metainfo',
)

install_data(
  'icons/hicolor/scalable/apps/org.gsword.GSword.svg',
  install_dir: get_option('datadir') / 'icons' / 'hicolor' / 'scalable' / 'apps',
)

install_data(
  '../COPYING',
  install_dir: get_option('datadir') / 'doc' / 'gsword',
)
