<component type="desktop-application">
  <id>org.gsword.GSword</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-2.0-or-later</project_license>

  <name>GSword</name>
  <summary>Bible study application for GNOME</summary>

  <description>
    <p>
      GSword is a GTK4 Bible study application for reading, comparing, and
      studying Scripture with SWORD modules.
    </p>
    <p>
      It provides a focused reading view, multi-version comparison, commentary
      and original-language resources, personal notes and highlights, reading
      plans, and a module library for installing and updating SWORD content.
    </p>
  </description>

  <screenshots>
    <screenshot type="default">
      <caption>Read Scripture with a focused reading view</caption>
      <image type="source">https://raw.githubusercontent.com/yetist/gsword/main/data/screenshots/reader.png</image>
    </screenshot>
    <screenshot>
      <caption>Compare multiple Bible translations side by side</caption>
      <image type="source">https://raw.githubusercontent.com/yetist/gsword/main/data/screenshots/compare.png</image>
    </screenshot>
    <screenshot>
      <caption>Keep notes, prayer, reading plans, and collections together</caption>
      <image type="source">https://raw.githubusercontent.com/yetist/gsword/main/data/screenshots/personal.png</image>
    </screenshot>
    <screenshot>
      <caption>Follow a daily reading plan</caption>
      <image type="source">https://raw.githubusercontent.com/yetist/gsword/main/data/screenshots/plans.png</image>
    </screenshot>
    <screenshot>
      <caption>Install and manage SWORD modules</caption>
      <image type="source">https://raw.githubusercontent.com/yetist/gsword/main/data/screenshots/library.png</image>
    </screenshot>
    <screenshot>
      <caption>Search across installed modules</caption>
      <image type="source">https://raw.githubusercontent.com/yetist/gsword/main/data/screenshots/search.png</image>
    </screenshot>
  </screenshots>

  <launchable type="desktop-id">org.gsword.GSword.desktop</launchable>
  <provides>
    <binary>gsword</binary>
  </provides>

  <categories>
    <category>Education</category>
  </categories>

  <keywords>
    <keyword>Bible</keyword>
    <keyword>Scripture</keyword>
    <keyword>Study</keyword>
    <keyword>Christian</keyword>
    <keyword>SWORD</keyword>
  </keywords>

  <url type="homepage">https://github.com/yetist/gsword</url>
  <url type="bugtracker">https://github.com/yetist/gsword/issues</url>

  <developer id="github.com.yetist">
    <name>yetist</name>
  </developer>

  <content_rating type="oars-1.1"/>

  <translation type="gettext">gsword</translation>

  <releases>
    <release version="0.2.0" date="2026-11-06">
      <description>
        <p>Personal study center and narrow desktop support.</p>
        <ul>
          <li>Add notes, prayer journal, insights, reading plans, bookmarks, and verse collections.</li>
          <li>Add versioned application data with schema migration support.</li>
          <li>Support 800x600 windows with a collapsible sidebar and compact reader controls.</li>
          <li>Improve module library filtering and plan management.</li>
        </ul>
      </description>
    </release>
    <release version="0.1.0" date="2026-11-04">
      <description>
        <p>Initial preview release.</p>
      </description>
    </release>
  </releases>
</component>
